<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>NSMicrophoneUsageDescription</key>
  <string>Maqto records voiceovers from your microphone.</string>
  <!-- project files: same types as bundle.fileAssociations, plus the document icon -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key><string>Maqto Project</string>
      <key>CFBundleTypeExtensions</key><array><string>maqto</string><string>kadr</string></array>
      <key>LSItemContentTypes</key><array><string>app.maqto.project</string></array>
      <key>CFBundleTypeRole</key><string>Editor</string>
      <key>LSHandlerRank</key><string>Owner</string>
      <key>CFBundleTypeIconFile</key><string>maqto-doc.icns</string>
    </dict>
  </array>
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key><string>app.maqto.project</string>
      <key>UTTypeDescription</key><string>Maqto Project</string>
      <key>UTTypeConformsTo</key><array><string>public.json</string><string>public.data</string></array>
      <key>UTTypeIconFile</key><string>maqto-doc.icns</string>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key><array><string>maqto</string><string>kadr</string></array>
        <key>public.mime-type</key><string>application/x-maqto</string>
      </dict>
    </dict>
  </array>
</dict>
</plist>
