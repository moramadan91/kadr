{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kadr",
  "version": "0.4.0",
  "identifier": "app.kadr.editor",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Kadr",
        "width": 1480,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 680,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "windowEffects": {
          "effects": [
            "underWindowBackground",
            "mica"
          ],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' http://127.0.0.1:* data: blob:; media-src 'self' http://127.0.0.1:* blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data: blob: http://127.0.0.1:*; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis"
    ],
    "category": "Video",
    "shortDescription": "Video editor",
    "copyright": "Free to use",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "nsis": {
        "languages": [
          "Arabic",
          "English"
        ],
        "displayLanguageSelector": true
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyMzUwMjg4MTJFQUE2QTcKUldTbnB1b1NpQUkxb3FWMFN0OEM0aVhBaGd1bkRKaWNaVFdZWDhMdU1xZWxDb0kya3lwN0xNc3MK",
      "endpoints": [
        "https://github.com/moramadan91/kadr/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
